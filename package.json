{
  "name": "neumann",
  "private": true,
  "version": "0.1.0",
  "description": "NEUMANN — enterprise operational data & decision platform (Foundry-inspired kernel)",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev:up": "docker compose up -d",
    "dev:down": "docker compose down",
    "cbs": "pnpm --filter common-build-system cli",
    "docs": "pnpm --filter dynamic-documentation cli",
    "alc": "pnpm --filter auto-logging-config cli",
    "metrics": "pnpm --filter metrics-collection cli",
    "iam": "pnpm --filter passo03-iam-auth-monitoring cli",
    "sec": "pnpm --filter passo03-security-config-secrets cli",
    "ldpc": "pnpm --filter ldpc-transceiver cli",
    "psm": "pnpm --filter periodic-search-manager cli",
    "fqs": "pnpm --filter fair-query-scheduler cli",
    "bfs": "pnpm --filter bounded-fair-scheduler cli",
    "obs": "pnpm --filter observability cli",
    "bus": "pnpm --filter event-bus cli",
    "lcv": "pnpm --filter link-consistency-validator cli",
    "ead": "pnpm --filter entity-assignment-debugger cli",
    "vrn": "pnpm --filter validation-result-notifier cli",
    "csd": "pnpm --filter cli-script-debugger cli",
    "its": "pnpm --filter inline-tag-sync cli",
    "ece": "pnpm --filter external-content-exporter cli",
    "tip": "pnpm --filter tagging-interface-panel cli",
    "sr": "pnpm --filter schema-registry cli",
    "contracts": "pnpm --filter contracts cli",
    "csdk": "pnpm --filter connector-sdk cli",
    "connector-sdk": "pnpm --filter connector-sdk cli",
    "cpg": "pnpm --filter connector-postgres cli",
    "connector-postgres": "pnpm --filter connector-postgres cli",
    "hpp": "pnpm --filter history-preserving-pipeline cli",
    "ds": "pnpm --filter history-preserving-pipeline cli",
    "delta": "pnpm --filter delta-storage cli",
    "mrtx": "pnpm --filter multi-row-transactions cli",
    "tt": "pnpm --filter multi-row-transactions cli",
    "xform": "pnpm --filter transformation-runner cli",
    "tr": "pnpm --filter transformation-runner cli",
    "ips": "pnpm --filter incremental-pipeline-scheduler cli",
    "dagsched": "pnpm --filter incremental-pipeline-scheduler cli",
    "dq": "pnpm --filter data-quality cli",
    "sandbox": "pnpm --filter execution-sandbox cli",
    "sbx": "pnpm --filter execution-sandbox cli",
    "lineage": "pnpm --filter data-lineage cli",
    "dl": "pnpm --filter data-lineage cli",
    "policy": "pnpm --filter policy-engine cli",
    "authz": "pnpm --filter policy-engine cli",
    "onto": "pnpm --filter ontology-registry cli",
    "ontology": "pnpm --filter ontology-registry cli",
    "obj": "pnpm --filter object-platform cli",
    "objects": "pnpm --filter object-platform cli",
    "kg": "pnpm --filter knowledge-graph cli",
    "links": "pnpm --filter knowledge-graph cli",
    "er": "pnpm --filter entity-resolution cli",
    "resolve": "pnpm --filter entity-resolution cli",
    "object-set": "pnpm --filter object-set test",
    "actions": "pnpm --filter action-engine test",
    "api": "pnpm --filter platform-api cli",
    "demo:sales": "tsx scripts/demo-sales-gd.ts",
    "gate:bloco1": "pnpm --filter observability cli -- check && pnpm --filter event-bus cli -- gate",
    "gate:t1.3": "pnpm --filter connector-postgres cli -- gate-t1.3",
    "gate:platform": "pnpm --filter object-set test && pnpm --filter platform-api test"
  },
  "devDependencies": {
    "tsx": "^4.16.0",
    "turbo": "2.1.1",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "action-engine": "workspace:*",
    "contracts": "workspace:*",
    "entity-resolution": "workspace:*",
    "knowledge-graph": "workspace:*",
    "object-platform": "workspace:*",
    "object-set": "workspace:*",
    "ontology-registry": "workspace:*",
    "platform-api": "workspace:*"
  }
}
