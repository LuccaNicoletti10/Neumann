{
  "name": "bounded-fair-scheduler",
  "version": "1.0.0",
  "description": "Agendador justo com fila de execução limitada (bounded) para cargas mistas de consultas — implementação funcional independente dos mecanismos da patente US 9,715,526 B2.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "bin": {
    "bounded-fair-scheduler": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cli": "tsx src/cli.ts",
    "serve": "tsx src/cli.ts serve"
  },
  "keywords": [
    "scheduler",
    "fair-scheduling",
    "bounded-queue",
    "backpressure",
    "keyset-pagination"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.16.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  }
}
