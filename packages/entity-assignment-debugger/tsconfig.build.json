{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    // WHY: emit must not include tests
    "rootDir": "src",
    // WHY: parent tsconfig is typecheck-only
    "noEmit": false,
    // WHY: this package already emitted without source maps; changing output requires a build evidence pass
    "sourceMap": false,
    // WHY: parent typecheck sets noEmit; build must emit declarations
    "declaration": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["tests/**/*.ts"]
}
