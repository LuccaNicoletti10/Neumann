{
  "name": "fair-query-scheduler",
  "version": "1.0.0",
  "description": "Escalonador justo (fair scheduling) para cargas mistas de consultas — implementação funcional independente dos mecanismos da patente US 9.092.482 B2.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fair-query-scheduler": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "serve": "tsx src/cli.ts serve"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "20.14.15",
    "tsx": "^4.16.0",
    "typescript": "5.5.4",
    "vitest": "^2.1.9"
  }
}
