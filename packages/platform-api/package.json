{
  "name": "platform-api",
  "version": "1.0.0",
  "description": "Foundry-like /api/v2 gateway — ontologies, objects, links, objectSets, actions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=forks --fileParallelism=false",
    "cli": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "worker:ingest": "tsx src/ingestion-worker.ts",
    "worker:function": "tsx bin/function-worker.ts"
  },
  "license": "MIT",
  "dependencies": {
    "action-engine": "workspace:*",
    "api-errors": "workspace:*",
    "contracts": "workspace:*",
    "fastify": "catalog:",
    "jose": "^5.9.6",
    "knowledge-graph": "workspace:*",
    "event-bus": "workspace:*",
    "entity-resolution": "workspace:*",
    "function-registry": "workspace:*",
    "object-platform": "workspace:*",
    "object-set": "workspace:*",
    "ontology-registry": "workspace:*",
    "pagination": "workspace:*",
    "policy-engine": "workspace:*",
    "explore-api": "workspace:*",
    "ingestion-runtime": "workspace:*",
    "aip-gateway": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.16.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  }
}
