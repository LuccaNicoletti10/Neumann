{
  "name": "ldpc-transceiver",
  "version": "1.0.0",
  "description": "Transceptor LDPC completo (encoder QC-LDPC, interleavers, QAM, decoder BP) - implementacao funcional independente inspirada na familia de patentes CA3111603",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "bin": {
    "ldpc-transceiver": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli.ts",
    "serve": "tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "20.14.15",
    "tsx": "^4.16.0",
    "typescript": "5.5.4",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
