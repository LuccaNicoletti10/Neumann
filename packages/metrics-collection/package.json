{
  "name": "metrics-collection",
  "version": "1.0.0",
  "description": "Sistema de coleta e visualizacao de metricas de uso de software (implementacao independente baseada funcionalmente na US 11,870,666 B2)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "start": "node dist/cli.js serve"
  },
  "dependencies": {
    "fastify": "^4.28.0",
    "pino": "^9.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
