{
  "name": "replication",
  "version": "1.0.0",
  "description": "Replication protocol: incremental chunks, cross-ontology map, cross-ACL redaction, ACL-as-mutation (US 8,886,601 / 9,785,694 / 9,330,157 / 10,061,828 / 8,527,461 / 8,782,004 / 9,715,518 / 10,089,345 / 10,621,198 / 8,838,538). Gate Passo 33.",
  "type": "module",
