{
  "name": "tagging-interface-panel",
  "version": "1.0.0",
  "description": "Painel de tagging interface sobre conteúdo externo com auto-preenchimento de campos, tags de objeto/propriedade/link, busca e sincronização com internal database e exportação (reimplementação funcional independente).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tagging-interface-panel": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.16.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  }
}
