{
  "name": "schema-registry",
  "version": "1.0.0",
  "description": "Schema registry + classificador de drift (compatible/coercible/breaking/unknown) e descoberta automática de schema de fontes novas (US 9,330,120).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "schema-registry": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "20.14.15",
    "tsx": "^4.16.0",
    "typescript": "5.5.4",
    "vitest": "^2.1.9"
  }
}
