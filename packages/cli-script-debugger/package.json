{
  "name": "cli-script-debugger",
  "version": "1.0.0",
  "description": "Depurador de transformation scripts via linha de comando com associação a ontology parameters (reimplementação funcional independente).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cli-script-debugger": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.16.0",
    "typescript": "catalog:",
