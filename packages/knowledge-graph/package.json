  "files": ["dist", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "license": "MIT",
  "dependencies": {
    "contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.14.15",
