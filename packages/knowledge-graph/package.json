{
  "name": "knowledge-graph",
  "version": "1.0.0",
  "description": "Links tipados + Knowledge Graph multi-hop + remote refs (US20250077899A1 / US 9,378,526 / US 9,621,676 / US 9,906,623).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
