{
  "name": "federation",
  "version": "1.0.0",
  "description": "Federation planner + pushdown + temporary objects + optional materialization (US 10,402,397 / US 11,281,659 / US 11,681,690). Gate T1.5.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "federation": "./dist/cli.js",
    "fed": "./dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "license": "MIT",
  "dependencies": {
    "contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.14.15",
    "tsx": "^4.16.0",
    "typescript": "5.5.4",
    "vitest": "^2.1.9"
  }
}
