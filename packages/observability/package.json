{
  "name": "observability",
  "version": "1.0.0",
  "description": "Instrumentacao compartilhada pino + OpenTelemetry para NEUMANN TM0.5 — todo request emite trace_id, principal, service, version, deployment_id, operation, duration_ms, result e tenant_id.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "observability": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "serve": "tsx src/cli.ts serve"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/instrumentation-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "fastify": "^4.28.0",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "20.14.15",
    "tsx": "^4.16.0",
    "typescript": "5.5.4",
    "vitest": "^2.1.9"
  }
}
