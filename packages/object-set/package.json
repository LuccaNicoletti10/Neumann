{
  "name": "object-set",
  "version": "1.0.0",
  "description": "ObjectSet algebra — BASE/FILTER/UNION/INTERSECT/SUBTRACT/STATIC/SEARCH_AROUND (Foundry-inspired; OpenFoundry Apache-2.0 adapted).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:parity": "node ../../scripts/run-fail-closed-vitest.mjs tests/parity.integration.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "api-errors": "workspace:*",
    "contracts": "workspace:*",
    "object-platform": "workspace:*",
    "pagination": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  }
}
