{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DATABASE_URL", "CONNECTOR_PROTOCOL", "AGE_BIN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "outputs": [],
      "passThroughEnv": ["DATABASE_URL", "CONNECTOR_PROTOCOL", "AGE_BIN"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
